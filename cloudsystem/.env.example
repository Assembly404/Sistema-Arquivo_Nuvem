# Copia este ficheiro para `.env` (mesma pasta) e preenche os valores.
# O `.env` esta no .gitignore — NUNCA committar segredos.
# Spring Boot importa este ficheiro automaticamente (spring.config.import).

# ---- Base de dados PostgreSQL ----
DB_URL=jdbc:postgresql://localhost:5432/storagearchivedb
DB_USERNAME=postgres
DB_PASSWORD=troca-me

# ---- JWT (minimo 32 caracteres) ----
# Gera com: openssl rand -base64 48
JWT_SECRET=troca-me-por-um-segredo-aleatorio-com-32-caracteres-ou-mais

# ---- Master key AES para os containers (Base64 -> 16/24/32 bytes) ----
# Gera com: openssl rand -base64 32
# ATENCAO: mudar esta chave impossibilita desencriptar ficheiros ja existentes.
CLOUD_MASTER_KEY=troca-me-base64-32-bytes

# ---- Seed inicial (conta ADMIN) ----
# Em producao define SEMPRE um email e uma password proprios.
# A password tem de cumprir: 8-24, maiuscula, minuscula, numero e simbolo.
# Se nao definires, sao usados os valores de desenvolvimento (ver docs/SEED.md).
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@arquivonuvem.local
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_SURNAME=Sistema
# Cria pastas demo (Documentos, Imagens, Projetos) para o ADMIN.
SEED_DEMO_DATA=false

# ---- Email OTP (opcional; desativado por omissao) ----
# MAIL_ENABLED=true
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tuaconta@gmail.com
# MAIL_PASSWORD=app-password-de-16-caracteres
# Em dev, ver o codigo OTP no log (NUNCA true em producao):
MAIL_DEV_LOG_OTP=true
